# Brain. Lives in the Electron MAIN process only — never the renderer.
FIREWORKS_API_KEY=fw_...

# Anam. The renderer receives short-lived session tokens, never this key.
# Session tokens expire after 3600s — see renderer reconnect handling.
ANAM_API_KEY=

# Avatar + voice.
# Verified against the account's library on 2026-07-30. All 10 stock avatars
# are photorealistic humans; there is no goblin. Gabriel/table is the closest
# stand-in for testing — the goblin question is still open (see README).
ANAM_AVATAR_ID=6cc28442-cccd-42a8-b6e4-24b7210a09c5
ANAM_AVATAR_MODEL=cara-4

# Archie (Cartesia sonic-3.5). Closest to Tony's spec: mid-baritone, dry, no
# announcer polish. Alternatives in the same account:
#   90c1fb05-4fc0-11f1-84b0-52bacf74fa75  Cooper - Friendly Mate     (CARTESIA)
#   8e67ed57-4fc0-11f1-84b0-52bacf74fa75  Laurent - Dependable Anchor (CARTESIA)
#   de23e340-1416-4dd8-977d-065a7ca11697  Lucy - Fresh & Casual      (ELEVENLABS)
# Anam runs Cartesia sonic-3.5 and ElevenLabs flash under the hood — the same
# low-latency engines we shortlisted for the persona, already wired in.
ANAM_VOICE_ID=91b4ce0f-4fc0-11f1-84b0-52bacf74fa75

# Observation cadence. 1500ms is deterministic AX reads only — no model calls
# happen on the tick, so this is cheap. Lower it if state changes feel laggy.
TICK_MS=1500
