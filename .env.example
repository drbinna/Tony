# Brain. Lives in the Electron MAIN process only — never the renderer.
FIREWORKS_API_KEY=fw_...

# Anam. The renderer receives short-lived session tokens, never this key.
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_AVATAR_MODEL=cara-4
ANAM_VOICE_ID=

# Observation cadence. 1500ms is deterministic AX reads only — no model calls
# happen on the tick, so this is cheap. Lower it if state changes feel laggy.
TICK_MS=1500
