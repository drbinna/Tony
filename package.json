{
  "name": "tony-app",
  "version": "0.1.0",
  "private": true,
  "description": "Tony — goblin cloud tutor overlay. Watches the AWS console via the macOS accessibility tree, speaks through an Anam avatar.",
  "main": "main.js",
  "scripts": {
    "build:observer": "bash observer/build.sh",
    "start": "npm run build && electron .",
    "start:nobuild": "electron .",
    "start:pilot": "TONY_PILOT=1 electron .",
    "doctor": "node test/doctor.js",
    "transcript": "node test/transcript-cat.js",
    "build:renderer": "esbuild renderer/renderer.js --bundle --format=esm --platform=browser --outfile=renderer/bundle.js",
    "build": "npm run build:observer && npm run build:renderer",
    "watch:renderer": "esbuild renderer/renderer.js --bundle --format=esm --platform=browser --outfile=renderer/bundle.js --watch"
  },
  "dependencies": {
    "@anam-ai/js-sdk": "^2.0.0",
    "@anthropic-ai/sdk": "^0.115.0",
    "dotenv": "^16.4.5",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "esbuild": "^0.28.1"
  }
}
