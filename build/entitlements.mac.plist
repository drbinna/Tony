<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron requires JIT under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Tony hears the learner: the Anam mic capture lives in the renderer. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Native helpers (ax-dump, drive) are our own unsigned-at-build-time
       binaries loaded from app.asar.unpacked. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
