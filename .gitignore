# Secrets — never commit. .env.example is the template that ships.
.env
.env.local
.env.*.local

# Compiled helpers (built per-machine by observer/build.sh)
observer/ax-dump
observer/drive
observer/*.dSYM

# Generated renderer bundle (npm run build:renderer)
renderer/bundle.js

# Node
node_modules/
npm-debug.log*
package-lock.json

# Electron build output
dist/
out/

# macOS
.DS_Store

# Session transcripts (debugging; may contain spoken conversation)
transcripts/

# Per-session lesson handoff artifacts (Terraform + step logs)
lesson-artifacts/
.lesson-profile/

# Vercel project link (proxy deploys)
proxy/.vercel/

# Notarization credentials (app-specific password) — never commit
build/notarize.env

# Vercel project link (landing site deploys)
site/.vercel/
